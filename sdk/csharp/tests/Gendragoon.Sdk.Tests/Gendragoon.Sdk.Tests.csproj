<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- dotnet run -p:SdkTfm=netstandard2.1 runs the suite against the .NET Standard build (managed AES-GCM and
       P-256, as used under Unity) instead of the .NET 8 build. -->
  <ItemGroup Condition="'$(SdkTfm)' == ''">
    <ProjectReference Include="../../src/Gendragoon.Sdk/Gendragoon.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SdkTfm)' != ''">
    <ProjectReference Include="../../src/Gendragoon.Sdk/Gendragoon.Sdk.csproj" SetTargetFramework="TargetFramework=$(SdkTfm)" />
  </ItemGroup>
</Project>
