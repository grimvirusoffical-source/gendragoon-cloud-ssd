# GenDragoonSSD — NON-SECRET development settings
# These IDs are distinct. Do not replace the storage project ID with the Firebase project ID.
GOOGLE_CLOUD_PROJECT=gendragoonssd
STORAGE_PROJECT_ID=gendragood-ssd
STORAGE_BUCKET_NAME=gen-dragoon-ssd
# Production private customer storage MUST be in a separate private bucket with its own scoped IAM.
# Supply Stripe secrets, Firebase Admin identity, approved terms URLs and price mappings
# only through a secure backend secret manager, never here and never in the Mac .app.
PUBLIC_URL=https://your-approved-https-backend.example
STRIPE_PRICE_IDS_JSON={}
TERMS_URL=https://your-published-terms.example/terms
PRIVACY_URL=https://your-published-terms.example/privacy
