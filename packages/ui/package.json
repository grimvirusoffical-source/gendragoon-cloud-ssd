{
  "name": "@gendragoon/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared GenDragoon React UI: uploader, backup, lock, settings, and BYO setup.",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./tokens.json",
    "./theme-runtime": "./src/theme-runtime.ts"
  },
  "scripts": {
    "typecheck": "node scripts/build-tokens.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@gendragoon/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
