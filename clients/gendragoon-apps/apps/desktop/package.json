{
  "name": "@gendragoon/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GenDragoon Cloud SSD for Windows. The Mac app stays the SwiftUI client.",
  "author": {
    "name": "Red-XAI LLC",
    "email": "support@infected-nation.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build && node scripts/build-main.mjs",
    "build:rotten-apple": "GENDRAGOON_DISTRIBUTION=rotten-apple pnpm build",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "screenshots": "vite build && node scripts/capture.mjs",
    "test": "vitest run",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb tar.gz --publish never",
    "e2e:electron": "node scripts/e2e-electron.mjs",
    "dist:win-zip": "pnpm build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@gendragoon/core": "workspace:*",
    "@gendragoon/ui": "workspace:*",
    "@gendragoon/updater": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.25.4",
    "puppeteer-core": "24.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  },
  "homepage": "https://example.com/gendragoon"
}
