# Leave empty until the Cloud Run URL exists. The app then stays in local preview.
EXPO_PUBLIC_API_BASE=
# Optional web billing page. Pay to restore opens a checkout URL from core when one is returned.
EXPO_PUBLIC_BILLING_URL=
# Optional Google sign-in. When unset, Sign in opens a local preview session.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
