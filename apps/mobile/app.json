{
  "expo": {
    "name": "GenDragoon",
    "slug": "gendragoon",
    "scheme": "gendragoon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#100e17",
    "ios": {
      "bundleIdentifier": "com.gendragoon.cloudssd",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gendragoon.cloudssd",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#100e17"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
