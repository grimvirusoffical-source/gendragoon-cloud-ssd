{
  "expo": {
    "name": "GenDragoon",
    "slug": "gendragoon",
    "scheme": "gendragoon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#0d0b14",
    "ios": {
      "bundleIdentifier": "com.gendragoon.cloudssd",
      "supportsTablet": true,
      "infoPlist": {
        "NSHumanReadableCopyright": "© Red-XAI LLC"
      }
    },
    "android": {
      "package": "com.gendragoon.cloudssd",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0b14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0b14"
    }
  }
}
